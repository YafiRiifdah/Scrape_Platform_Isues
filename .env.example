# Salin ke .env lalu isi nilainya. Jangan commit file .env.

# API key Claude (https://platform.claude.com), dipakai bila analysis.provider = anthropic (default)
ANTHROPIC_API_KEY=

# Key penyedia alternatif bila analysis.provider = openai_compatible (Gemini, Groq, OpenRouter, ...).
# Nama variabelnya bisa diubah lewat analysis.api_key_env di config.yaml. Ollama lokal tidak perlu key.
LLM_API_KEY=

# Hanya untuk adapter cadangan 'instaloader'. Username akun Instagram SEKUNDER (bukan akun utama)
IG_USERNAME=

# Kunci induk untuk mengenkripsi token Apify yang disimpan di database (AES-256-GCM).
# Jangan diisi manual: jalankan `spi key init`. Bila kunci ini hilang, token harus dihubungkan ulang.
SPI_MASTER_KEY=

# Token Apify TIDAK lagi disimpan di sini. Setiap pengguna menghubungkan token miliknya sendiri:
#   spi --user NAMA apify connect
# Cara lama (masih didukung hanya untuk pengguna `default`, tidak terenkripsi). Pindahkan dengan
# `spi apify connect --from-env`, lalu kosongkan baris ini.
APIFY_TOKEN=

# Opsional. Pengguna bawaan bila --user tidak ditulis (default: default).
# SPI_USER=

# Hanya untuk adapter cadangan 'tiktokapi'. Cookie msToken dari tiktok.com:
# buka tiktok.com di browser -> DevTools (F12) -> Application -> Cookies -> msToken
TIKTOK_MS_TOKEN=

# Opsional. Path browser untuk scraper TikTok. Kosong = otomatis pakai Edge/Chrome terpasang,
# karena Chromium bawaan Playwright kadang diblokir Windows saat dibuka berjendela.
# Contoh: C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
SPI_BROWSER_PATH=
