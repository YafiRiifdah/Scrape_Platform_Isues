# Salin ke .env lalu isi nilainya. Jangan commit file .env.

# API key Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Username akun Instagram SEKUNDER untuk login scraper (bukan akun utama)
IG_USERNAME=

# Token Apify untuk scraper TikTok default (adapter tiktok_apify):
# apify.com -> Console -> Settings -> Integrations -> Personal API tokens
APIFY_TOKEN=

# Hanya untuk adapter cadangan 'tiktokapi'. Cookie msToken dari tiktok.com:
# buka tiktok.com di browser -> DevTools (F12) -> Application -> Cookies -> msToken
TIKTOK_MS_TOKEN=

# Opsional. Path browser untuk scraper TikTok. Kosong = otomatis pakai Edge/Chrome terpasang,
# karena Chromium bawaan Playwright kadang diblokir Windows saat dibuka berjendela.
# Contoh: C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
SPI_BROWSER_PATH=
